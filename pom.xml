<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!--
        Parent POM (rodzic) całego kursu SpringLearning.
        - Dziedziczy po spring-boot-starter-parent: stąd wersje WSZYSTKICH bibliotek Springa (BOM — bill of materials,
          czyli „spis części” z wersjami), ustawienia kompilatora i pluginów.
        - Sam nie zawiera kodu (packaging = pom). Kod jest w modułach — jeden moduł = jeden dział kursu.
        - Moduły dopisujemy do <modules> dopiero wtedy, gdy dział powstaje.
    -->
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>springlearning</groupId>
    <artifactId>spring-learning</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>SpringLearning</name>
    <description>Kurs Spring Boota po polsku: lekcje sprawdzane testami, ćwiczenia i rozwiązania wzorcowe.</description>

    <modules>
        <module>s00-start</module>
        <module>s01-core-ioc</module>
        <module>s02-configuration</module>
        <module>s03-boot-basics</module>
        <module>s04-web-rest</module>
        <module>s05-validation</module>
        <module>s06-error-handling</module>
        <module>s07-data-jdbc</module>
        <module>s08-data-jpa</module>
    </modules>

    <properties>
        <!-- Minimalna wersja Javy kursu (zalecana 25 — kod kompiluje się do poziomu 21, więc działa na 21 i 25). -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!--
            Testy ćwiczeń (@Tag("cwiczenie")) są domyślnie WYŁĄCZONE, żeby nierozwiązane ćwiczenia nie psuły budowania.
            To właściwość, a nie konfiguracja pluginu, więc da się ją nadpisać z linii poleceń:
              ./mvnw -pl s00-start test -Dgroups=cwiczenie -DexcludedGroups=none
        -->
        <excludedGroups>cwiczenie</excludedGroups>

        <!-- Aplikacja uruchamiana przez ./mvnw spring-boot:run startuje z małą pamięcią startową (patrz argLine niżej). -->
        <spring-boot.run.jvmArguments>-Xms128m</spring-boot.run.jvmArguments>

        <!-- Biblioteki spoza BOM Spring Boota (używane w późniejszych działach). -->
        <springdoc.version>3.1.1</springdoc.version>
        <spring-modulith.version>2.1.1</spring-modulith.version>
        <spring-ai.version>2.0.1</spring-ai.version>
    </properties>

    <dependencies>
        <!-- Wspólne dla wszystkich działów: JUnit, AssertJ, Mockito, Spring Test. Tylko do testów (scope test). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        Mockito jako agent Javy (java agent — program doładowany do JVM przed testami, który może zmieniać klasy).
                        Bez tego Mockito próbuje SAM podłączyć się do działającej JVM (self-attach). Nowe JDK to ograniczają,
                        a na Windows z antywirusem kończy się to błędem „Could not self-attach to current VM” — i każdy test
                        z @MockitoBean pada. Tak zaleca dokumentacja Mockito. Wersja pochodzi z BOM Spring Boota (mockito.version).
                        -Xshare:off wyłącza ostrzeżenie JVM „Sharing is only supported for boot loader classes…”, które agent
                        powoduje (nieszkodliwe, ale myli przy czytaniu logów).
                        IntelliJ przekazuje argLine także przy ▶ (Settings → Build Tools → Maven → Running Tests → argLine).
                        -Xms128m: mała pamięć startowa JVM testów. Domyślnie JVM rezerwuje na starcie 1/64 RAM (przy 64 GB to
                        1 GB) — kilka równoległych buildów wyczerpywało wtedy pamięć Windows („Plik stronicowania jest za mały”).
                        Limit maksymalny (-Xmx) zostaje domyślny, więc testy nadal mogą urosnąć, ile potrzebują.
                    -->
                    <argLine>"-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar" -Xshare:off -Xms128m</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
