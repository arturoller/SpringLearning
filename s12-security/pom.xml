<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!--
        Moduł s12-security — dział 12: Spring Security 7 — domyślne zabezpieczenia, SecurityFilterChain, role
        i @PreAuthorize, użytkownicy i hasła (BCrypt), bezstanowe API i CSRF, JWT (resource server), testy bezpieczeństwa.
    -->
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>springlearning</groupId>
        <artifactId>spring-learning</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>s12-security</artifactId>
    <name>s12-security</name>

    <dependencies>
        <!-- webmvc = Spring MVC: kontrolery REST, wbudowany serwer Tomcat, JSON (Jackson). W Boot 3 nazywał się -web. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- security = Spring Security: filtry, uwierzytelnianie, autoryzacja. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- oauth2-resource-server = sprawdzanie tokenów JWT w zapytaniach (Bearer). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Narzędzia do testowania warstwy web: MockMvc, @WebMvcTest, @AutoConfigureMockMvc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- security-test = @WithMockUser, user(...), jwt(), csrf() do testów MockMvc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
