<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!--
        Moduł s14-openapi — dział 14: dokumentacja API — springdoc-openapi, Swagger UI, adnotacje dokumentujące, grupy i wersje API.
    -->
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>springlearning</groupId>
        <artifactId>spring-learning</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>s14-openapi</artifactId>
    <name>s14-openapi</name>

    <dependencies>
        <!-- Spring MVC + Jackson 3. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Bean Validation — springdoc pokazuje ograniczenia w schemacie. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- springdoc-openapi: dokument OpenAPI (/v3/api-docs) i Swagger UI. Spoza BOM Boota — wersja z parent pom. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <!-- Testy webowe: MockMvc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
