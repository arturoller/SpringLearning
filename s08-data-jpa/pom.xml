<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!--
        Moduł s08-data-jpa — dział 8: Spring Data JPA — encje, repozytoria, zapytania z nazw metod, @Query, stronicowanie i sortowanie, Flyway + JPA. Bez weba.
    -->
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>springlearning</groupId>
        <artifactId>spring-learning</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>s08-data-jpa</artifactId>
    <name>s08-data-jpa</name>

    <dependencies>
        <!-- Spring Data JPA + Hibernate 7 + JDBC (DataSource). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- H2 — baza w pamięci; potrzebna tylko w czasie działania (runtime), w kodzie używamy JDBC/JPA, nie klas H2. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Flyway — wersjonowane migracje bazy (V1__…sql). Każda lekcja ma własny katalog migracji. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Testy wycinkowe JPA: @DataJpaTest, TestEntityManager. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
