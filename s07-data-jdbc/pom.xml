<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!--
        Moduł s07-data-jdbc — dział 7: bazy danych przez JDBC — JdbcClient, JdbcTemplate, schema.sql/data.sql, migracje Flyway, repozytorium. Bez weba.
    -->
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>springlearning</groupId>
        <artifactId>spring-learning</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>s07-data-jdbc</artifactId>
    <name>s07-data-jdbc</name>

    <dependencies>
        <!-- JDBC w Springu: JdbcClient, JdbcTemplate, DataSource (pula HikariCP), transakcje. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- H2 — baza w pamięci; potrzebna tylko w czasie działania (runtime), w kodzie używamy JDBC/JPA, nie klas H2. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Flyway — wersjonowane migracje bazy (V1__…sql). Każda lekcja ma własny katalog migracji. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Testy wycinkowe bazy: @JdbcTest. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
