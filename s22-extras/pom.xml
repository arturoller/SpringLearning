<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!--
        Moduł s22-extras — dział 22: dodatki (opcjonalne) — Spring AI, Kafka, OAuth2/Keycloak, tracing, przegląd WebFlux, GraalVM native image.
    -->
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>springlearning</groupId>
        <artifactId>spring-learning</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>s22-extras</artifactId>
    <name>s22-extras</name>

    <dependencyManagement>
        <dependencies>
            <!-- BOM Spring AI (spoza BOM Boota) — wersja z parent pom: spring-ai.version. -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring MVC + Jackson 3. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Spring AI z lokalnym modelem Ollama (bez klucza API; w testach atrapa modelu, bez internetu). -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <!-- Kafka — kolejka wiadomości (w testach broker w kontenerze, pomijany bez Dockera). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <!--
            Resource Server (JWT) — lekcja o OAuth2/Keycloak. Wnosi Spring Security do całego modułu!
            Boot 4: spring-boot-starter-security-oauth2-resource-server. Dawna nazwa spring-boot-starter-oauth2-resource-server
            w 4.1.1 jest przestarzała („deprecated in favor of spring-boot-starter-security-oauth2-resource-server”).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <!-- OpenTelemetry — śledzenie rozproszone (tracing) i metryki. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <!-- WebFlux — tylko lekcja przeglądowa o programowaniu reaktywnym (aplikacja lekcji przełącza typ na REACTIVE). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- Testy webowe (MVC). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testy WebFlux: WebTestClient. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testy zabezpieczeń: jwt() dla MockMvc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Testy OpenTelemetry (odpowiednik startera opentelemetry w testach, Boot 4). Bez niego testy EKSPORTUJĄ ślady
            i metryki jak działająca aplikacja (np. próby wysłania metryk na localhost:4318). Z nim Boot w każdym teście
            ustawia management.tracing.export.enabled=false i management.defaults.metrics.export.enabled=false,
            a lekcja o śledzeniu włącza śledzenie adnotacją @AutoConfigureTracing.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Eksporter śladów W PAMIĘCI (InMemorySpanExporter) — test sprawdza odcinki bez zewnętrznego serwera. Wersja z BOM Boota. -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-testing</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers w Spring Boot (@ServiceConnection). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers + JUnit 5. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Kafka w kontenerze. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
