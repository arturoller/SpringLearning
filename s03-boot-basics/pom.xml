<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!--
        Moduł s03-boot-basics — dział 3: podstawy Spring Boota — autokonfiguracja (jak Boot „zgaduje” konfigurację),
        pisanie własnej autokonfiguracji, SpringApplication, startery. Bez weba: aplikacje lekcji nie uruchamiają serwera.
    -->
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>springlearning</groupId>
        <artifactId>spring-learning</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>s03-boot-basics</artifactId>
    <name>s03-boot-basics</name>

    <dependencies>
        <!-- starter = rdzeń: spring-core, spring-context (kontener IoC), autokonfiguracja, logowanie, jakarta.annotation. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- Jackson 3 (biblioteka JSON) + jej autokonfiguracja — przykład autokonfiguracji, która „wycofuje się”,
             gdy zdefiniujesz własny bean. Tu nie budujemy API webowego, tylko obserwujemy, co Boot konfiguruje sam. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>
    </dependencies>
</project>
