<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!--
        Moduł s06-error-handling — dział 6: obsługa błędów — domyślne błędy Boota, @ExceptionHandler, @RestControllerAdvice,
        ProblemDetail (RFC 9457) i własne wyjątki domenowe. Walidacja (starter-validation) jest potrzebna do błędów 400.
    -->
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>springlearning</groupId>
        <artifactId>spring-learning</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>s06-error-handling</artifactId>
    <name>s06-error-handling</name>

    <dependencies>
        <!-- webmvc = Spring MVC: kontrolery REST, Tomcat, JSON (Jackson 3). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- validation = Jakarta Bean Validation (adnotacje @NotBlank, @Size…) + Hibernate Validator (implementacja). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Narzędzia do testowania warstwy web: MockMvc, @WebMvcTest. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
