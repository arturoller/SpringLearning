<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!--
        Moduł s04-web-rest — dział 4: REST w Springu MVC — kontrolery, dane z zapytania, odpowiedzi i kody HTTP, JSON
        (Jackson 3), CRUD, CORS, wersjonowanie API (Spring Framework 7). Startery: webmvc + webmvc-test.
    -->
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>springlearning</groupId>
        <artifactId>spring-learning</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>s04-web-rest</artifactId>
    <name>s04-web-rest</name>

    <dependencies>
        <!-- webmvc = Spring MVC: kontrolery REST, wbudowany serwer Tomcat, JSON (Jackson). W Boot 3 nazywał się -web. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Narzędzia do testowania warstwy web: MockMvc, @WebMvcTest, @AutoConfigureMockMvc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
